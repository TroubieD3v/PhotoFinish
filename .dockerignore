# The image needs the Go sources and web/ (the UI stage builds it). Patterns
# without a slash match at the top of the build context only.
.git
.github
.tmp*
tmp*
bin
dist
reports
photofinish
*.exe
*.log
*.sarif
*.html
*.xml
*.db
*.db-journal
*.db-wal
*.db-shm
.idea
.vscode

# Local web build artifacts: the UI stage installs its own node_modules and
# writes internal/ui/dist/app itself.
web/node_modules
web/dist
web/test-results
web/playwright-report
web/blob-report
web/.vite
internal/ui/dist/app

# Media for the README and the scripts that make it; the image needs neither.
web/media
docs/*.gif
docs/*.png
docs/screenshots
